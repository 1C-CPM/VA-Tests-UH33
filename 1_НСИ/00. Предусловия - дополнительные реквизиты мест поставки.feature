Функционал: 00. Предусловия набора: окружение и дополнительные реквизиты мест поставки

	Как Аналитик я хочу
	подготовить пустую базу, созданную из cf, к прогону набора
	чтобы сценарии не зависели от данных и настроек базы авторов

# Сценарий 02.07 "Места поставки" (1_НСИ\02. Закупки) и закупочные сценарии 6_Закупки выбирают
# дополнительные реквизиты "Инкотермс" (тип - перечисление Инкотермс) и "Условия поставки" (значения
# свойства) справочника "Места поставки", но ни один сценарий набора их не создаёт: у авторов они были в базе.

Сценарий: 00.01 Дополнительные реквизиты мест поставки
	* Создание реквизитов и значений, если их нет
		И я выполняю код встроенного языка на сервере без контекста
			"""bsl
			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Н.Ссылка КАК Ссылка ИЗ Справочник.НаборыДополнительныхРеквизитовИСведений КАК Н ГДЕ Н.Наименование ПОДОБНО ""%Места поставки%"" И НЕ Н.ПометкаУдаления");
			Выборка = Запрос.Выполнить().Выбрать();
			Если НЕ Выборка.Следующий() Тогда
				ВызватьИсключение "Не найден набор дополнительных реквизитов справочника ""Места поставки""";
			КонецЕсли;
			Набор = Выборка.Ссылка;
			Свойства = Новый Массив;
			Свойства.Добавить(Новый Структура("Заголовок, Тип, Значения", "Инкотермс", "ПеречислениеСсылка.Инкотермс", Новый Массив));
			Свойства.Добавить(Новый Структура("Заголовок, Тип, Значения", "Условия поставки", "СправочникСсылка.ЗначенияСвойствОбъектов", СтрРазделить("Склад|Ж/д станция|Терминал ", "|")));
			Для Каждого Описание Из Свойства Цикл
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 С.Ссылка КАК Ссылка ИЗ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК С ГДЕ С.Заголовок = &Заголовок И С.НаборСвойств = &Набор И НЕ С.ПометкаУдаления");
				Запрос.УстановитьПараметр("Заголовок", Описание.Заголовок);
				Запрос.УстановитьПараметр("Набор", Набор);
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Свойство = Выборка.Ссылка;
				Иначе
					Объект = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
					Объект.Заголовок = Описание.Заголовок;
					Объект.Наименование = Описание.Заголовок + " (" + Строка(Набор) + ")";
					Объект.НаборСвойств = Набор;
					Объект.ТипЗначения = Новый ОписаниеТипов(Описание.Тип);
					Объект.Доступен = Истина;
					Объект.Виден = Истина;
					Объект.ДополнительныеЗначенияИспользуются = Описание.Значения.Количество() > 0;
					Объект.Имя = "VA_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
					Объект.Записать();
					Свойство = Объект.Ссылка;
					НаборОбъект = Набор.ПолучитьОбъект();
					НаборОбъект.ДополнительныеРеквизиты.Добавить().Свойство = Свойство;
					НаборОбъект.КоличествоРеквизитов = Формат(НаборОбъект.ДополнительныеРеквизиты.Количество(), "ЧН=0; ЧГ=0");
					НаборОбъект.Используется = Истина;
					НаборОбъект.Записать();
				КонецЕсли;
				Для Каждого ИмяЗначения Из Описание.Значения Цикл
					Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 З.Ссылка КАК Ссылка ИЗ Справочник.ЗначенияСвойствОбъектов КАК З ГДЕ З.Владелец = &Свойство И З.Наименование = &Имя И НЕ З.ПометкаУдаления");
					Запрос.УстановитьПараметр("Свойство", Свойство);
					Запрос.УстановитьПараметр("Имя", ИмяЗначения);
					Если Запрос.Выполнить().Пустой() Тогда
						Значение = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
						Значение.Владелец = Свойство;
						Значение.Наименование = ИмяЗначения;
						Значение.Записать();
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			"""

Сценарий: 00.02 Без предложения подключить проверку контрагентов
	* Проверка контрагентов отключена принудительно (как кнопка "Больше не показывать")
		И я выполняю код встроенного языка на сервере без контекста
			"""bsl
			Если Метаданные.Константы.Найти("ИспользоватьПроверкуКонтрагентов") <> Неопределено Тогда
				Константы.ИспользоватьПроверкуКонтрагентов.Установить(2);
			КонецЕсли;
			"""

Сценарий: 00.03 Единица измерения шт в классификаторе
	# 02.09 "Товарные категории" и закупки выбирают единицу "шт" (796, Штука) из классификатора, но не создают её
	# (единицы "т", "кг", "л", "упак" сценарии создают сами); в пустой базе её нет.
	* Создание единицы, если её нет
		И я выполняю код встроенного языка на сервере без контекста
			"""bsl
			Если Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796").Пустая() Тогда
				Единица = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
				Единица.Код = "796";
				Единица.Наименование = "шт";
				Единица.НаименованиеПолное = "Штука";
				Единица.Записать();
			КонецЕсли;
			"""

Сценарий: 00.04 Виды номенклатуры Спецодежда Спецоснастка Товары
	# 02.10 "Номенклатура" и закупки выбирают эти виды номенклатуры, но не создают их; в пустой базе
	# начальное заполнение их не создаёт (есть "Материалы", "Продукция", "Работы", "Услуги", "Топливо" и др.).
	* Создание видов, если их нет
		И я выполняю код встроенного языка на сервере без контекста
			"""bsl
			Виды = Новый Массив;
			Виды.Добавить(Новый Структура("Имя, НаПродажу, ВЭксплуатациюСотрудникам, ВПроизводство", "Спецодежда", Ложь, Истина, Ложь));
			Виды.Добавить(Новый Структура("Имя, НаПродажу, ВЭксплуатациюСотрудникам, ВПроизводство", "Спецоснастка", Ложь, Истина, Истина));
			Виды.Добавить(Новый Структура("Имя, НаПродажу, ВЭксплуатациюСотрудникам, ВПроизводство", "Товары", Истина, Ложь, Ложь));
			Для Каждого Описание Из Виды Цикл
				Если Справочники.ВидыНоменклатуры.НайтиПоНаименованию(Описание.Имя, Истина).Пустая() Тогда
					Вид = Справочники.ВидыНоменклатуры.СоздатьЭлемент();
					Вид.Наименование = Описание.Имя;
					Вид.ПолучаемОтПоставщика = Истина;
					Вид.НаПродажу = Описание.НаПродажу;
					Вид.ВЭксплуатациюСотрудникам = Описание.ВЭксплуатациюСотрудникам;
					Вид.ВПроизводство = Описание.ВПроизводство;
					Вид.Записать();
				КонецЕсли;
			КонецЦикла;
			"""

Сценарий: 00.06 Недельные периоды бюджетирования 2024 года
	# 03. Бюджетирование (00.23) выбирает в документе "Отражение фактических данных" период БДДС
	# "1 неделя. Январь 2024 г." / "1 неделя. Февраль 2024 г.": у авторов недельные периоды в базе были, начальное
	# заполнение чистой базы создаёт только год, полугодие, квартал, месяц - список выбора поля пуст.
	# Здесь - штатное создание периодов справочника: недели внутри 2024 года, переподчинение месяцам.
	* Недельные периоды 2024 года
		И я выполняю код встроенного языка на сервере без контекста
			"""bsl
			Запрос = Новый Запрос(
			"ВЫБРАТЬ П.Ссылка КАК Ссылка ИЗ Справочник.Периоды КАК П
			|ГДЕ П.Периодичность = ЗНАЧЕНИЕ(Перечисление.Периодичность.Год) И П.ДатаНачала = &ДатаНачала
			|И НЕ П.Произвольный И НЕ П.ПометкаУдаления");
			Запрос.УстановитьПараметр("ДатаНачала", Дата(2024, 1, 1));
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Недели = Новый Массив;
				Недели.Добавить(Перечисления.Периодичность.Неделя);
				Справочники.Периоды.СоздатьПериоды(Выборка.Ссылка, Недели);
			Иначе
				ВызватьИсключение "Нет периода 2024 г. в справочнике Периоды";
			КонецЕсли;
			"""

Сценарий: 00.07 Тип БД текущей информационной базы
	# 3_Бюджетирование (01.13) ждёт в форме "Укажите ключевые реквизиты документа" внешнюю ИБ "Текущая информационная база":
	# форма подбирает её по совпадению ТипБД с правилом обработки, а у предопределённого элемента в чистой базе ТипБД пуст.
	* Тип БД у предопределённой внешней ИБ "Текущая информационная база"
		И я выполняю код встроенного языка на сервере без контекста
			"""bsl
			ТекущаяИБ = Справочники.ВнешниеИнформационныеБазы.ТекущаяИБ.ПолучитьОбъект();
			Если НЕ ЗначениеЗаполнено(ТекущаяИБ.ТипБД) Тогда
				ТекущаяИБ.ТипБД = Справочники.ТипыБазДанных.ТекущаяИБ;
				ТекущаяИБ.Записать();
			КонецЕсли;
			"""
